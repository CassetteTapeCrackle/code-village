# Dependencies
node_modules/

# Build output
dist/
.wrangler/

# Test output
test-results/
playwright-report/

# Generated content (tools/content_check.py, scripts/copy-pyodide.mjs)
public/pyodide/
src/content/bundle.json
src/content/bundle.json.sha256

# Local secrets
.env
.env.*
!.env.example
worker/.dev.vars

# Python bytecode
__pycache__/

# Local-only notes, plans and agent scratch: kept on disk, never in the repo.
# Project rules, skills and hooks are committed so cloud sessions get them.
/docs/*
!/docs/test-framework/
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/cloud-setup.sh
.opencode/
.superpowers/
.handoff/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
