{
  "name": "code-village",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "content": "uv run -q --no-project --python 3.14 --with numpy==2.4.6 --with pandas==3.0.2 --with scikit-learn==1.8.0 --with ruff==0.17.0 python tools/content_check.py",
    "pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "pnpm palette && pnpm content --if-changed && pnpm pyodide && vite",
    "build": "pnpm palette && pnpm content && pnpm pyodide && vite build",
    "preview": "vite preview",
    "test": "pnpm content && vitest run",
    "test:py": "uv run -q --no-project --python 3.14 --with ruff==0.17.0 python -m unittest discover -s tools -p 'test_*.py'",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "e2e": "playwright test",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:migrate": "wrangler d1 migrations apply code-village --local --config worker/wrangler.jsonc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "palette": "node scripts/palette.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.32.0",
    "codemirror": "^6.0.2",
    "marked": "^18.1.3",
    "pyodide": "314.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
