{
  "name": "code-village",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "code-village",
      "database_id": "local-only-until-owner-creates-it",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TUTOR_MODEL": "@cf/google/gemma-4-26b-a4b-it",
  },
}
